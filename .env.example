# Copy to .env for local Docker Compose. Never commit the populated .env file.
DB_PASSWORD=root
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
MANAGER_USERNAME=eventmanager
MANAGER_PASSWORD=manager123
CUSTOMER_USERNAME=customer
CUSTOMER_PASSWORD=customer123

# Google OAuth2 Sign-Up / Sign-In (UserService)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/auth/google/callback
GOOGLE_VERIFY_TOKEN=false

# Razorpay & Gmail SMTP / Mailpit Integrations
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=replace-with-a-random-secret-at-least-32-characters

# For Gmail SMTP: set MAIL_HOST=smtp.gmail.com, MAIL_PORT=587, GMAIL_USERNAME=your@gmail.com, GMAIL_APP_PASSWORD=your-app-password
# For local Mailpit testing: set MAIL_HOST=mailpit, MAIL_PORT=1025
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
GMAIL_USERNAME=
GMAIL_APP_PASSWORD=
MAIL_FROM=noreply@tickethub.com
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
NOTIFICATION_DEFAULT_RECIPIENT=customer@tickethub.com
NOTIFICATION_DEFAULT_NAME=TicketHub Customer

# Cloud S3 Media Storage (Optional, defaults to local fallback)
AWS_S3_ENABLED=false
AWS_S3_BUCKET=tickethub-media-bucket
AWS_S3_REGION=ap-south-1

# Keycloak Identity Provider (Optional, profile: auth)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

